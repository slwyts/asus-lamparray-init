#!/usr/bin/env python3
"""Initialize an ASUS 0B05:19B6 I2C-HID LampArray keyboard."""

from __future__ import annotations

import argparse
import fcntl
import glob
import os
import struct
import sys
import time
from pathlib import Path

DEFAULT_CONFIG = Path("/etc/asus-lamparray-init.conf")
DEVICE_GLOB = "/sys/bus/hid/devices/*:0B05:19B6.*/hidraw/hidraw*"
HID_REPORT_ATTRIBUTES = 0x41
HID_REPORT_RANGE_UPDATE = 0x45
HID_REPORT_CONTROL = 0x46


class LampArrayError(RuntimeError):
    pass


def hid_ioctl(direction: int, number: int, size: int) -> int:
    return (direction << 30) | (size << 16) | (ord("H") << 8) | number


def set_feature(fd, payload: bytes) -> None:
    data = bytearray(payload)
    fcntl.ioctl(fd, hid_ioctl(3, 0x06, len(data)), data, True)


def get_feature(fd, report_id: int, size: int) -> bytes:
    data = bytearray(size)
    data[0] = report_id
    fcntl.ioctl(fd, hid_ioctl(3, 0x07, size), data, True)
    return bytes(data)


def parse_color(value: str) -> tuple[int, int, int]:
    normalized = value.strip().removeprefix("#")
    if len(normalized) != 6:
        raise ValueError("颜色必须是六位十六进制 RGB，例如 ff0000")
    try:
        return tuple(bytes.fromhex(normalized))  # type: ignore[return-value]
    except ValueError as exc:
        raise ValueError("颜色必须是六位十六进制 RGB，例如 ff0000") from exc


def load_config(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for number, raw_line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise LampArrayError(f"{path}:{number}: 配置格式应为 KEY=VALUE")
        key, value = line.split("=", 1)
        values[key.strip().upper()] = value.strip().strip('"').strip("'")
    return values


def find_device(wait_seconds: float) -> Path:
    deadline = time.monotonic() + wait_seconds
    while True:
        matches = sorted(glob.glob(DEVICE_GLOB))
        if matches:
            return Path("/dev") / Path(matches[0]).name
        if time.monotonic() >= deadline:
            raise LampArrayError("未找到 ASUS I2C-HID LampArray 0B05:19B6")
        time.sleep(0.25)


def build_range_update(lamp_count: int, rgb: tuple[int, int, int], intensity: int) -> bytes:
    if not 1 <= lamp_count <= 0x10000:
        raise LampArrayError(f"控制器返回了无效灯区数量：{lamp_count}")
    if not 0 <= intensity <= 255:
        raise LampArrayError("亮度必须在 0 到 255 之间")
    return struct.pack(
        "<BBHHBBBB",
        HID_REPORT_RANGE_UPDATE,
        0x01,
        0,
        lamp_count - 1,
        *rgb,
        intensity,
    )


def initialize(device: Path, rgb: tuple[int, int, int], intensity: int, probe: bool) -> int:
    mode = "rb" if probe else "rb+"
    try:
        with device.open(mode, buffering=0) as fd:
            attributes = get_feature(fd, HID_REPORT_ATTRIBUTES, 23)
            lamp_count = struct.unpack_from("<H", attributes, 1)[0]
            print(f"设备：{device}，灯区：{lamp_count}")
            if probe:
                return lamp_count
            set_feature(fd, bytes([HID_REPORT_CONTROL, 0x00]))
            set_feature(fd, build_range_update(lamp_count, rgb, intensity))
    except PermissionError as exc:
        raise LampArrayError(f"没有权限打开 {device}，请使用 sudo") from exc
    except OSError as exc:
        raise LampArrayError(f"操作 {device} 失败：{exc}") from exc
    return lamp_count


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description="初始化 ASUS 0B05:19B6 I2C-HID LampArray 键盘背光"
    )
    result.add_argument("--config", type=Path, default=DEFAULT_CONFIG, help="配置文件路径")
    result.add_argument("--color", help="六位十六进制 RGB，例如 ff0000")
    result.add_argument("--intensity", type=int, help="LampArray 强度，0-255")
    result.add_argument("--wait", type=float, default=10.0, help="等待设备出现的秒数")
    result.add_argument("--probe", action="store_true", help="仅检测设备，不改变灯光")
    return result


def main() -> int:
    args = parser().parse_args()
    try:
        config = load_config(args.config)
        color_text = args.color or config.get("COLOR", "ff0000")
        intensity = args.intensity if args.intensity is not None else int(config.get("INTENSITY", "255"))
        rgb = parse_color(color_text)
        if not 0 <= intensity <= 255:
            raise ValueError("亮度必须在 0 到 255 之间")
        if args.wait < 0:
            raise ValueError("等待时间不能为负数")
        device = find_device(args.wait)
        initialize(device, rgb, intensity, args.probe)
        if not args.probe:
            print(f"已设置颜色 #{color_text.lstrip('#').lower()}，强度 {intensity}")
        return 0
    except (LampArrayError, ValueError) as exc:
        print(f"错误：{exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
